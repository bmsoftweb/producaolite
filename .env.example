# Porta do ProducaoLite (portal B2B 3000, admin B2B 3001, comprasWeb 3002, estoqueWeb 3003, producaoLite 3004)
PRODUCAO_PORT=3004

# ------------------------------------------------------------
# Servidores da bmAPI (D:\bmsoft\BMapi)
# No login o usuário digita o número do servidor; URL, porta e token (X-API-Key)
# vêm da tabela servidores deste MySQL. O token nunca chega ao navegador.
# A base do servidor precisa estar com allowWrite=true no config.ini da bmAPI.
# ------------------------------------------------------------
MYSQL_HOST=45.224.130.145
MYSQL_PORT=3306
MYSQL_USER=bmsoftadm
MYSQL_PASSWORD=
MYSQL_DATABASE=bmapi

# Segredo usado para assinar o token de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=

# ------------------------------------------------------------
# Regras de negócio
# ------------------------------------------------------------
# Empresa (EMPRESAS.ID) cujo estoque e produção são usados
ID_EMPRESA=1
